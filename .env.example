# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloudflare Turnstile Keys (defaults to Cloudflare official testing keys if omitted in dev)
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Admin Authentication Secret
ADMIN_SESSION_SECRET="dsssb-tgt-cs-production-admin-secret-change-me"
ADMIN_DEFAULT_USERNAME="admin"
ADMIN_DEFAULT_PASSWORD="dsssb-admin-2026"

# Local SQLite database path for Node/Express runtime (Cloudflare D1 used in Worker runtime)
SQLITE_DB_PATH="./data/dsssb_tgt_cs.sqlite"
